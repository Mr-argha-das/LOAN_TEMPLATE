{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chola-loan-app",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chola-loan-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "chola-loan-files"
    }
  ]
}
